class Student {
    String name;
    int age;

    Student() {
        name = "Prasanth";
        age = 25;
    }

    void display() {
        System.out.println(name);
        System.out.println(age);
    }
}

public class Main {
    public static void main(String[] args) {
        Student s = new Student();
        s.display();
    }
}
